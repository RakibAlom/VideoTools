# Apache / LiteSpeed Web Server Configuration for Animal Dance Studio
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Route /api/* requests to api.php
  RewriteRule ^api/remux-mp4$ api.php?action=remux-mp4 [L,QSA]
  RewriteRule ^api/save-file$ api.php?action=save-file [L,QSA]
  RewriteRule ^api/status$ api.php?action=status [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, OPTIONS, HEAD"
  Header set Access-Control-Allow-Headers "*"
</IfModule>
